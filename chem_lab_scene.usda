def "ChemLabPhysics"
{
    def Cube "FloorCollider" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        token visibility = "invisible"
        float3 xformOp:scale = (14.8, 19.920006, 0.1)
        double3 xformOp:translate = (-6.6884778981752735, 2.336671187052423, -2.8314999999999997)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

over "moebius_mecanum_base"
{
    over "left_front_wheel_link"
    {
        def Sphere "wheel_contact" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token purpose = "guide"
            double radius = 0.05
        }
    }

    over "left_rear_wheel_link"
    {
        def Sphere "wheel_contact" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token purpose = "guide"
            double radius = 0.05
        }
    }

    over "right_front_wheel_link"
    {
        def Sphere "wheel_contact" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token purpose = "guide"
            double radius = 0.05
        }
    }

    over "right_rear_wheel_link"
    {
        def Sphere "wheel_contact" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token purpose = "guide"
            double radius = 0.05
        }
    }
}

def Xform "Beaker" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    prepend references = @./chem_lab/lab.usd@</root/Lab/ST_Acc_BechersGlass03_mo>
)
{
    float physics:mass = 0.05
    float3 xformOp:rotateXYZ = (-90, 0, 8.78)
    double3 xformOp:translate = (-6.3623786773405735, 4.10377408831297, -2.7464)

    over "ST_Acc_BechersGlass03_md" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </ChemLab/materials/ST_Acc_ScienceGlass01>
        rel material:binding:physics = </PhysicsMaterials/BeakerGrip> (
            bindMaterialAs = "weakerThanDescendants"
        )
        uniform token physics:approximation = "convexHull"
    }
}

def "PhysicsMaterials"
{
    def Material "BeakerGrip" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.9
        float physics:restitution = 0
        float physics:staticFriction = 1
    }
}

def "Cameras"
{
    def Camera "LabView"
    {
        float2 clippingRange = (0.01, 1000)
        float focalLength = 18.147562
        custom vector3d omni:kit:centerOfInterest = (0, 0, -7.523382737173485)
        matrix4d xformOp:transform = ( (0.604499140687366, -0.7966057926655041, 0, 0), (0.47747327059362255, 0.36232749552227783, 0.8004611557453509, 0), (-0.6376519934704707, -0.48387808080168043, 0.5993846328884458, 0), (-9.6533, 1.0845, 0.6561, 1) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }
}

def OmniGraph "FeedbackGraph"
{
    token evaluationMode = "Automatic"
    token evaluator:type = "execution"
    token fabricCacheBacking = "Shared"
    int2 fileFormatVersion = (1, 9)
    token pipelineStage = "pipelineStageSimulation"

    def OmniGraphNode "tick" (
        prepend apiSchemas = ["NodeGraphNodeAPI"]
    )
    {
        token node:type = "omni.graph.action.OnPlaybackTick"
        int node:typeVersion = 2
        custom uint outputs:tick
    }

    def OmniGraphNode "context" (
        prepend apiSchemas = ["NodeGraphNodeAPI"]
    )
    {
        token node:type = "isaacsim.ros2.bridge.ROS2Context"
        int node:typeVersion = 2
        custom uint64 outputs:context
    }

    def OmniGraphNode "sim_time" (
        prepend apiSchemas = ["NodeGraphNodeAPI"]
    )
    {
        token node:type = "isaacsim.core.nodes.IsaacReadSimulationTime"
        int node:typeVersion = 1
        custom double outputs:simulationTime
    }

    def OmniGraphNode "pub_clock" (
        prepend apiSchemas = ["NodeGraphNodeAPI"]
    )
    {
        custom uint64 inputs:context
        prepend uint64 inputs:context.connect = </FeedbackGraph/context.outputs:context>
        custom uint inputs:execIn
        prepend uint inputs:execIn.connect = </FeedbackGraph/tick.outputs:tick>
        custom double inputs:timeStamp
        prepend double inputs:timeStamp.connect = </FeedbackGraph/sim_time.outputs:simulationTime>
        custom string inputs:topicName = "clock"
        token node:type = "isaacsim.ros2.bridge.ROS2PublishClock"
        int node:typeVersion = 1
    }

    def OmniGraphNode "pub_joint_states" (
        prepend apiSchemas = ["NodeGraphNodeAPI"]
    )
    {
        custom uint64 inputs:context
        prepend uint64 inputs:context.connect = </FeedbackGraph/context.outputs:context>
        custom uint inputs:execIn
        prepend uint inputs:execIn.connect = </FeedbackGraph/tick.outputs:tick>
        custom rel inputs:targetPrim = </moebius_mecanum_base/base_footprint>
        custom double inputs:timeStamp
        prepend double inputs:timeStamp.connect = </FeedbackGraph/sim_time.outputs:simulationTime>
        custom string inputs:topicName = "joint_states"
        token node:type = "isaacsim.ros2.bridge.ROS2PublishJointState"
        int node:typeVersion = 1
    }

    def OmniGraphNode "pub_world_tf" (
        prepend apiSchemas = ["NodeGraphNodeAPI"]
    )
    {
        custom uint64 inputs:context
        prepend uint64 inputs:context.connect = </FeedbackGraph/context.outputs:context>
        custom uint inputs:execIn
        prepend uint inputs:execIn.connect = </FeedbackGraph/tick.outputs:tick>
        custom rel inputs:parentPrim
        custom rel inputs:targetPrims = [
            </moebius_mecanum_base/base_link>,
            </Beaker>,
        ]
        custom double inputs:timeStamp
        prepend double inputs:timeStamp.connect = </FeedbackGraph/sim_time.outputs:simulationTime>
        token node:type = "isaacsim.ros2.bridge.ROS2PublishTransformTree"
        int node:typeVersion = 1
    }
}

